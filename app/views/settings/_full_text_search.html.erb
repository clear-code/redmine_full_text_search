<% settings = FullTextSearch::Settings.new(settings) unless settings.is_a?(FullTextSearch::Settings) %>
<p>
  <%= label_tag("settings[display_score]",
                l(:label_full_text_search_display_score)) %>
  <%= check_box("settings",
                "display_score",
                checked: settings.display_score?) %>
</p>

<p>
  <%= label_tag("settings[display_similar_issues]",
                l(:label_full_text_search_display_similar_issues)) %>
  <%= check_box("settings",
                "display_similar_issues",
                checked: settings.display_similar_issues?) %>
</p>


<p>
  <%= label_tag("settings[enable_fuzzy_search]",
                l(:label_full_text_search_enable_fuzzy_search)) %>
  <%= check_box("settings",
                "enable_fuzzy_search",
                checked: settings.enable_fuzzy_search?) %>
</p>

<p>
  <%= label_tag("settings[fuzzy_max_distance_ratio]",
                l(:label_full_text_search_fuzzy_max_distance_ratio)) %>
  <%= text_field_tag("settings[fuzzy_max_distance_ratio]",
                     settings.fuzzy_max_distance_ratio,
                     size: 6) %>
  <em class="info"><%= l(:text_full_text_search_fuzzy_max_distance_ratio_note) %></em>
</p>

<p>
  <%= label_tag("settings[enable_tracking]",
                l(:label_full_text_search_enable_tracking)) %>
  <%= check_box("settings",
                "enable_tracking",
                checked: settings.enable_tracking?) %>
</p>

<p>
  <%= label_tag("settings[attachment_max_text_size_in_mb]",
                l(:label_full_text_search_attachment_max_text_size)) %>
  <%= text_field_tag("settings[attachment_max_text_size_in_mb]",
                     settings.attachment_max_text_size_in_mb,
                     size: 6) %>
  <%= l(:"number.human.storage_units.units.mb") %>
</p>

<p>
  <%= label_tag("settings[text_extraction_timeout]",
                l(:label_full_text_search_text_extraction_timeout)) %>
  <%= text_field_tag("settings[text_extraction_timeout]",
                     settings.text_extraction_timeout,
                     size: 6) %>
</p>

<p>
  <%= label_tag("settings[external_command_max_memory_in_mb]",
                l(:label_full_text_search_external_command_max_memory)) %>
  <%= text_field_tag("settings[external_command_max_memory_in_mb]",
                     settings.external_command_max_memory_in_mb,
                     size: 6) %>
  <%= l(:"number.human.storage_units.units.mb") %>
</p>

<p>
  <%= label_tag("settings[server_url]",
                l(:label_full_text_search_server_url)) %>
  <%= text_field_tag("settings[server_url]",
                     settings.server_url) %>
</p>

<% if FullTextSearch::Partition.partitioned? &&
      FullTextSearch::Partition.parallel_logical_select_is_supported? %>
  <p>
    <%= label_tag("settings[n_workers]",
                  l(:label_full_text_search_n_workers)) %>
    <%= text_field_tag("settings[n_workers]",
                       settings.n_workers,
                       size: 6) %>
    <em class="info"><%= l(:text_full_text_search_n_workers_note) %></em>
  </p>
<% end %>


<section>
  <h3>
    <%= l(:label_full_text_search_synchronization_section) %>
  </h3>

  <div class="box">
    <p>
      <%= l(:text_full_text_search_synchronization_note) %>
    </p>
    <p>
      <%= button_to(l(:button_full_text_search_synchronize_now),
                    full_text_search_synchronize_path,
                    method: :post,
                    class: "button-positive",
                    data: { confirm: l(:text_full_text_search_synchronize_confirmation) }) %>
    </p>
  </div>

  <p>
    <%= label_tag("settings[enable_periodic_synchronization]",
                  l(:label_full_text_search_enable_periodic_synchronization)) %>
    <%= check_box("settings",
                  "enable_periodic_synchronization",
                  checked: settings.enable_periodic_synchronization?) %>
  </p>

  <p>
    <%= label_tag("settings[synchronization_interval]",
                  l(:label_full_text_search_synchronization_interval)) %>
    <%= select_tag("settings[synchronization_interval]",
                   options_for_select([
                     [l(:label_interval_hourly), "hourly"],
                     [l(:label_interval_every_6_hours), "every_6_hours"],
                     [l(:label_interval_daily), "daily"],
                     [l(:label_interval_weekly), "weekly"],
                     [l(:label_interval_custom), "custom"]
                   ], settings.synchronization_interval)) %>
  </p>

  <p>
    <%= label_tag("settings[synchronization_custom_cron]",
                  l(:label_full_text_search_synchronization_custom_cron)) %>
    <%= text_field_tag("settings[synchronization_custom_cron]",
                       settings.to_h["synchronization_custom_cron"],
                       placeholder: "0 2 * * *",
                       size: 15) %>
    <em class="info"><%= l(:text_full_text_search_custom_cron_note) %></em>
  </p>

  <div class="box info">
    <strong><%= l(:label_full_text_search_cron_command_example) %>:</strong><br>
    <code><%= settings.synchronization_cron %> cd <%= Rails.root %> && RAILS_ENV=production bundle exec rake full_text_search:synchronize</code>
  </div>
</section>

<section>
  <h3>
    <%= l(:label_full_text_search_semantic_section) %>
  </h3>

  <div class="box">
    <%= l(:text_full_text_search_semantic_note) %>
  </div>

  <p>
    <%= label_tag("settings[enable_semantic_search]",
                  l(:label_full_text_search_enable_semantic_search)) %>
    <%= check_box("settings",
                  "enable_semantic_search",
                  checked: settings.enable_semantic_search?) %>
  </p>

  <p>
    <%= label_tag("settings[semantic_model]",
                  l(:label_full_text_search_semantic_model)) %>
    <%= text_field_tag("settings[semantic_model]",
                       settings.semantic_model) %>
  </p>

  <p>
    <%= label_tag("settings[semantic_passage_prefix]",
                  l(:label_full_text_search_semantic_passage_prefix)) %>
    <%= text_field_tag("settings[semantic_passage_prefix]",
                       settings.semantic_passage_prefix) %>
  </p>

  <p>
    <%= label_tag("settings[semantic_query_prefix]",
                  l(:label_full_text_search_semantic_query_prefix)) %>
    <%= text_field_tag("settings[semantic_query_prefix]",
                       settings.semantic_query_prefix) %>
  </p>
</section>
